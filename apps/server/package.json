{
  "name": "@support-agent/server",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "seed:admin": "node --env-file-if-exists=.env dist/scripts/seed-admin.js",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "bun run typecheck && bun run lint"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.14",
    "@openrouter/sdk": "1.5.30",
    "better-auth": "1.7.14",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "http-errors": "2.0.1",
    "mongodb": "7.7.0",
    "mongoose": "9.11.4",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/http-errors": "2.0.5",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "13.2.0",
    "tsc-alias": "1.9.9",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
